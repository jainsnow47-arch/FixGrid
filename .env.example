# GEMINI_API_KEY: Required for server-side Gemini AI civic issue analysis and embeddings.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign JWT session tokens on the server.
# Falls back to an ephemeral cryptographic secret in memory when unset.
SESSION_SECRET=

# DEMO_MODE: Set to "false" to disable one-click demo role sign-in buttons in production.
DEMO_MODE=true

# DEMO_DEFAULT_PASSWORD: Optional password used when seeding local demo accounts.
DEMO_DEFAULT_PASSWORD=

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional pre-provisioned Platform Administrator credentials.
# Set these in environment variables / Secrets to configure a dedicated admin login hashed with bcrypt.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
